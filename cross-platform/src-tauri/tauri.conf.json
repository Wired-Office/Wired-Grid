{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wired Grid",
  "mainBinaryName": "wired-grid",
  "version": "1.0.1",
  "identifier": "com.wiredoffice.wiredgrid",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wired Grid",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "A fast, friendly spreadsheet",
    "longDescription": "Wired Grid is a spreadsheet with hundreds of functions, formatting, conditional formatting, filters, charts, templates and printing. Workbooks are .grid files that also open in Wired Grid for Mac, and it reads and writes Excel (.xlsx), CSV and TSV.",
    "publisher": "Wired Office",
    "copyright": "© Wired Office",
    "homepage": "https://github.com/Wired-Office/Wired-Grid",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["grid"],
        "name": "Wired Grid Workbook",
        "description": "Wired Grid Workbook",
        "mimeType": "application/vnd.wiredgrid.grid",
        "role": "Editor"
      },
      {
        "ext": ["xlsx"],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "Comma-Separated Values",
        "mimeType": "text/csv",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
